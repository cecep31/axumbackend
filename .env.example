# Config uses scoped keys where noted (DB_POOL_*, S3_*, APP_*).

# Server
PORT=8080
# Log filter (tracing EnvFilter syntax). Unset = the default below.
# RUST_LOG=axumbackend=info,tower_http=info,axum::rejection=trace

# Auth
# JWT_SECRET must be at least 32 characters long.
JWT_SECRET=
# JWT_EXPIRY is a duration string (e.g. "15m", "1h"). Legacy JWT_EXPIRY_HOURS
# (whole hours) is still supported as a fallback when JWT_EXPIRY is unset.
JWT_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY is the sliding session window (duration string, default
# 72h). Legacy REFRESH_TOKEN_EXPIRY_DAYS (whole days) is still read when
# REFRESH_TOKEN_EXPIRY is unset or invalid.
REFRESH_TOKEN_EXPIRY=72h
# Refresh tokens rotate on every use (same as echobackend). The chain dies at
# REFRESH_TOKEN_ABSOLUTE_EXPIRY no matter how often it is refreshed, and a
# rotated token stays usable for REFRESH_TOKEN_GRACE_PERIOD to absorb the
# client's own concurrent refreshes (0 disables it).
REFRESH_TOKEN_ABSOLUTE_EXPIRY=720h
REFRESH_TOKEN_GRACE_PERIOD=60s

# GitHub OAuth (leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/oauth/github/callback

# Frontend (used for OAuth redirects and cookies)
FRONTEND_URL=http://localhost:3000
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password
MAIN_DOMAIN=localhost

# Database
# DATABASE_URL is required (PostgreSQL connection DSN).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable&connect_timeout=10

# Database connection pool
# DB_POOL_MAX_OPEN (aliases: DB_POOL_MAX_SIZE, MAX_OPEN_CONNS)
DB_POOL_MAX_OPEN=25
# DB_POOL_MAX_IDLE (alias: MAX_IDLE_CONNS)
DB_POOL_MAX_IDLE=25
# DB_POOL_CONN_LIFETIME (alias: CONN_MAX_LIFETIME)
DB_POOL_CONN_LIFETIME=15m
# DB_POOL_CONN_IDLE_TIME (alias: CONN_MAX_IDLE_TIME)
DB_POOL_CONN_IDLE_TIME=5m
# DB_POOL_CONNECTION_TIMEOUT (axum-only; seconds or a duration string)
DB_POOL_CONNECTION_TIMEOUT=30
# Unparsable values fall back to their defaults (like echobackend). Durations
# shared with echobackend use Go syntax ("15m", "1h30m"; no bare numbers).

# Global HTTP rate limit: token bucket per client IP, sustained requests per
# second with a burst of 2x (0 = disabled). Same as echobackend.
# HTTP_RATE_LIMIT_RPS (aliases: RATE_LIMITER_MAX, legacy RATE_LIMIT_MAX_REQUESTS)
HTTP_RATE_LIMIT_RPS=0
# HTTP_RATE_LIMIT_WINDOW_SEC (aliases: RATE_LIMITER_TTL, legacy RATE_LIMIT_WINDOW_SECS) -
# idle visitor expiry in seconds (0 = 3 minutes). Not a counting window.
HTTP_RATE_LIMIT_WINDOW_SEC=0

# Per-request timeout for non-streaming routes (axum-only, 408 on expiry).
# HTTP_REQUEST_TIMEOUT_SECS (alias: REQUEST_TIMEOUT_SECS)
# HTTP_REQUEST_TIMEOUT_SECS=30

# When true, client IP for RealIP/logging uses X-Forwarded-For (use behind a trusted reverse proxy).
# HTTP_TRUST_PROXY (alias: TRUST_PROXY)
HTTP_TRUST_PROXY=false

# CORS allowed origins. Use "*" for any origin, or comma-separated list (e.g. "https://app.com,https://admin.com").
HTTP_ALLOW_ORIGINS=*

# S3-compatible storage (RustFS, AWS S3, …)
# S3_ENDPOINT (alias: MINIO_ENDPOINT)
S3_ENDPOINT=localhost:9000
# S3_ACCESS_KEY (alias: MINIO_ACCESS_KEY)
S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY (alias: MINIO_SECRET_KEY)
S3_SECRET_KEY=minioadmin
# S3_BUCKET (alias: MINIO_BUCKET)
S3_BUCKET=minio-bucket
# S3_USE_SSL (alias: MINIO_USE_SSL)
S3_USE_SSL=true

# Valkey / Redis for random/trending post caching, OAuth exchange codes, distributed auth rate
# limits, and realtime (guild SSE) pub/sub across instances. Key layout matches echobackend, so
# both backends can share one Redis. rediss:// is supported.
# REDIS_URL (alternative: VALKEY_URL) - Leave empty (or unreachable) to use in-memory fallbacks.
REDIS_URL=
CACHE_KEY_PREFIX=pilput
CACHE_TTL_SECONDS=60
# REDIS_CONNECT_TIMEOUT_MS (alias: VALKEY_CONNECT_TIMEOUT_MS) - capped at 2000; also the command timeout.
REDIS_CONNECT_TIMEOUT_MS=2000

# OpenRouter AI chat. Leave OPENROUTER_API_KEY empty to disable AI responses (stream endpoints return user message only).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=https://pilput.net
OPENROUTER_TITLE=pilput
OPENROUTER_TIMEOUT_SECONDS=90

# Email Configuration (SMTP for password reset, queued to 2 background workers)
# Leave SMTP_HOST empty to disable delivery (a devMode activity log is recorded instead).
# RESEND_API_KEY (axum-only) is used as the transport when SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_FROM (alias: EMAIL_FROM)
SMTP_FROM=noreply@pilput.net
# Set true for implicit TLS, usually port 465. Leave false for STARTTLS, usually port 587.
SMTP_TLS=false
# Per SMTP network operation timeout.
SMTP_TIMEOUT_SECONDS=10
# Overall task timeout for one email delivery attempt.
SMTP_TASK_TIMEOUT_SECONDS=30

# Enable debug logging and debug routes.
# APP_DEBUG (alias: DEBUG)
APP_DEBUG=false

# Market Data (RapidAPI)
# RAPIDAPI_KEY (alias: RAPIDAPI_IDX_KEY, RAPIDAPI_QUOTE_KEY): Required for IDX calendar and financial market quotes.
RAPIDAPI_KEY=
