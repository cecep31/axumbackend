# Server Configuration
PORT=8080
APP_DEBUG=false
DEBUG=false

# CORS and proxy
HTTP_ALLOW_ORIGINS=*
HTTP_TRUST_PROXY=false
TRUST_PROXY=false

# Database Configuration
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/axumbackend"

# Connection Pool Configuration
# Maximum number of connections in the pool (default: 20)
DB_POOL_MAX_SIZE=20

# Timeout for acquiring a connection in seconds (default: 30)
DB_POOL_CONNECTION_TIMEOUT=30

# Rate Limit Configuration
# Maximum requests per client IP and path within the configured window.
# Set to 0 to disable rate limiting (default: 0).
RATE_LIMIT_MAX_REQUESTS=0

# Rate limit window in seconds (default: 60)
RATE_LIMIT_WINDOW_SECS=60

# Echo-compatible global HTTP rate limit keys
HTTP_RATE_LIMIT_RPS=0
HTTP_RATE_LIMIT_WINDOW_SEC=0

# JWT Configuration
# Secret key for signing JWT tokens (CHANGE THIS IN PRODUCTION!)
JWT_SECRET="your-secret-key"

# Access token expiry in hours (default: 3)
JWT_EXPIRY_HOURS=3

# Refresh token expiry in days (default: 30)
REFRESH_TOKEN_EXPIRY_DAYS=30

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:8080/api/auth/oauth/github/callback"

# Frontend Configuration
FRONTEND_URL="http://localhost:3000"
FRONTEND_OAUTH_CALLBACK_URL="http://localhost:3000/auth/callback"
FRONTEND_RESET_PASSWORD_URL="http://localhost:3000/reset-password"
MAIN_DOMAIN="localhost"

# S3-compatible storage
S3_ENDPOINT="localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="minio-bucket"
S3_USE_SSL=true

# Valkey/Redis cache
VALKEY_URL=""
CACHE_KEY_PREFIX="pilput"
CACHE_TTL_SECONDS=60
VALKEY_CONNECT_TIMEOUT_MS=5000

# Background queue
QUEUE_REDIS_URL=""
ASYNQ_REDIS_URL=""
QUEUE_REDIS_TIMEOUT_MS=5000
QUEUE_DEFAULT_NAME="default"
QUEUE_CONCURRENCY=1
QUEUE_MAX_RETRY=5

# OpenRouter AI chat
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_DEFAULT_MODEL="openrouter/free"
OPENROUTER_HTTP_REFERER="https://pilput.net"
OPENROUTER_TITLE="pilput"
OPENROUTER_TIMEOUT_SECONDS=90

# Email Configuration (Resend API for password reset)
RESEND_API_KEY=""
EMAIL_FROM="noreply@pilput.net"

# SMTP email configuration
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@pilput.net"
SMTP_TLS=false
SMTP_TIMEOUT_SECONDS=10
SMTP_TASK_TIMEOUT_SECONDS=30
